SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Leave empty to use SQLite (the local and CI default).
DATABASE_URL=
# PostgreSQL example: DATABASE_URL=postgresql://user:password@host:5432/dbname
# Leave empty to use InMemoryChannelLayer (the local and CI default).
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

# Enable HTTPS-only settings only after TLS and the reverse proxy are ready.
SECURE_PROXY_SSL_HEADER=False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Safe response-header defaults for local and production environments.
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_REFERRER_POLICY=same-origin
X_FRAME_OPTIONS=DENY

# Defaults to DEBUG when DEBUG=True and INFO when DEBUG=False.
LOG_LEVEL=DEBUG

# Local email is written to the backend console; no SMTP server is required.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=webmaster@localhost
SERVER_EMAIL=root@localhost

# Production SMTP example (supply credentials through a secret manager):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=smtp-user
# EMAIL_HOST_PASSWORD=replace-through-secret-manager
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=noreply@example.com
# SERVER_EMAIL=server-errors@example.com

# Example only. Replace example.com and review all paths before installation.
# This file is intended for /etc/nginx/sites-available/dastorkon on Ubuntu.

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# $uri deliberately excludes query strings. Do not replace it with $request
# while WebSocket authentication uses a JWT query parameter.
log_format dastorkon_safe '$remote_addr [$time_local] '
                           '"$request_method $uri $server_protocol" '
                           '$status $body_bytes_sent';

upstream dastorkon_asgi {
    server 127.0.0.1:8000;
}

server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com;

    root /srv/dastorkon/app/frontend/dist;
    index index.html;
    client_max_body_size 20m;
    server_tokens off;

    access_log /dev/stdout dastorkon_safe;
    error_log /dev/stderr warn;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;

    location /static/ {
        alias /srv/dastorkon/app/staticfiles/;
        access_log off;
    }

    location /media/ {
        alias /srv/dastorkon/app/media/;
    }

    location ~ ^/api/health/(ready/)?$ {
        proxy_pass http://dastorkon_asgi;
        access_log off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://dastorkon_asgi;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location /ws/ {
        proxy_pass http://dastorkon_asgi;
        access_log off;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location = /admin {
        return 301 /admin/;
    }

    # These routes are owned by Django rather than the React SPA.
    location ~ ^/(admin|common|notifications)/ {
        proxy_pass http://dastorkon_asgi;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location = /index.html {
        add_header Cache-Control "no-store";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy same-origin always;
        add_header X-Frame-Options DENY always;
    }

    # React Router handles frontend paths that are not physical files.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # HTTPS is intentionally not templated here. Install and verify the real
    # certificate first, then add a reviewed 443 server and HTTP-to-HTTPS
    # redirect. Only then enable Django's HTTPS-only environment settings.
}

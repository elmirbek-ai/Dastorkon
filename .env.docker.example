# Local production-like validation only. Replace all credentials for real use.
POSTGRES_DB=dastorkon
POSTGRES_USER=dastorkon
POSTGRES_PASSWORD=local-only-change-me

SECRET_KEY=local-prod-like-only-change-before-real-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DATABASE_URL=postgresql://dastorkon:local-only-change-me@db:5432/dastorkon
REDIS_URL=redis://redis:6379/0

# Local HTTP requires these to remain disabled. Enable only with real HTTPS and
# a trusted reverse proxy that overwrites X-Forwarded-Proto.
SECURE_PROXY_SSL_HEADER=False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# These response-header defaults are safe for local HTTP too.
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_REFERRER_POLICY=same-origin
X_FRAME_OPTIONS=DENY

# Application logs are written to container stdout.
LOG_LEVEL=INFO

# Keep production-like local validation on console email (no SMTP required).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=webmaster@localhost
SERVER_EMAIL=root@localhost

# Real production SMTP example (store credentials outside Git):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=smtp-user
# EMAIL_HOST_PASSWORD=replace-through-secret-manager
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=noreply@example.com
# SERVER_EMAIL=server-errors@example.com

APP_PORT=8080
